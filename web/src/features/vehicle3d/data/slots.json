{
  "_doc": "Emplacements (slots) du véhicule, partagés par les rendus Simple et Réaliste (ADR 0035). match : expression régulière sur le nom du sous-ensemble normalisé (minuscules, sans accents, espaces simples). focusWith : slots éclatés avec lui en focus. explode : réglages de l'éclaté (fixed = ne bouge pas, lift = montée supplémentaire, xScale = renfort longitudinal).",
  "slots": [
    { "slot": "underbody", "match": "^(soubassement|fond plat)$", "explode": { "fixed": true } },
    { "slot": "front_structure", "match": "^structure avant$" },
    { "slot": "side_l", "match": "^cote de caisse gauche$" },
    { "slot": "side_r", "match": "^cote de caisse droite?$" },
    { "slot": "roof", "match": "^(toit|pavillon)$", "explode": { "lift": 0.9 } },
    { "slot": "protection", "match": "^protection$", "explode": { "fixed": true } },

    { "slot": "door_fl", "match": "^porte (avant|diedre) gauche$" },
    { "slot": "door_fr", "match": "^porte (avant|diedre) droite?$" },
    { "slot": "door_rl", "match": "^porte arriere gauche$" },
    { "slot": "door_rr", "match": "^porte arriere droite?$" },
    { "slot": "tailgate", "match": "^hayon$" },
    { "slot": "hood", "match": "^capot( avant)?$" },
    { "slot": "wing_fl", "match": "^aile avant gauche$" },
    { "slot": "wing_fr", "match": "^aile avant droite?$" },
    { "slot": "bumper_f", "match": "^bouclier avant$" },
    { "slot": "bumper_r", "match": "^bouclier arriere$" },
    { "slot": "mirror_l", "match": "^retroviseur( camera)? gauche$" },
    { "slot": "mirror_r", "match": "^retroviseur( camera)? droite?$" },
    { "slot": "glazing", "match": "^vitrage( fixe)?$" },

    { "slot": "engine", "match": "^moteur [0-9v]", "explode": { "lift": 0.7, "xScale": 1.4 } },
    { "slot": "gearbox", "match": "^boite (de vitesses|dct)" },
    { "slot": "cooling", "match": "^refroidissement$" },
    { "slot": "exhaust", "match": "^echappement$" },
    { "slot": "fuel", "match": "^(alimentation carburant|carburant)$" },

    { "slot": "corner_fl", "match": "^(train|coin) avant gauche$", "focusWith": ["wheel_fl"] },
    { "slot": "corner_fr", "match": "^(train|coin) avant droite?$", "focusWith": ["wheel_fr"] },
    { "slot": "corner_rl", "match": "^(train|coin) arriere gauche$", "focusWith": ["wheel_rl"] },
    { "slot": "corner_rr", "match": "^(train|coin) arriere droite?$", "focusWith": ["wheel_rr"] },
    { "slot": "wheel_fl", "match": "^roue avant gauche$", "focusWith": ["corner_fl"] },
    { "slot": "wheel_fr", "match": "^roue avant droite?$", "focusWith": ["corner_fr"] },
    { "slot": "wheel_rl", "match": "^roue arriere gauche$", "focusWith": ["corner_rl"] },
    { "slot": "wheel_rr", "match": "^roue arriere droite?$", "focusWith": ["corner_rr"] },
    { "slot": "subframe", "match": "^berceau et essieu$" },
    { "slot": "steering", "match": "^direction$" },
    { "slot": "brakes_central", "match": "^freinage central$" },
    { "slot": "spare_wheel", "match": "^roue de secours$" },

    { "slot": "energy", "match": "^(energie|reseau 12 v)$" },
    { "slot": "harness_cabin", "match": "^faisceau habitacle$" },
    { "slot": "harness_dash", "match": "^faisceau (planche de bord|cockpit)$" },
    { "slot": "harness_front", "match": "^faisceau avant$" },
    { "slot": "harness_rear", "match": "^faisceau arriere$" },
    { "slot": "harness_roof", "match": "^faisceau de pavillon$" },
    { "slot": "harness_floor", "match": "^faisceau (de plancher|chassis)$" },
    { "slot": "wiring_supports", "match": "^passages et supports$" },
    { "slot": "lights_front", "match": "^eclairage avant$" },
    { "slot": "lights_rear", "match": "^eclairage arriere$" },
    { "slot": "wipers", "match": "^essuyage$" },
    { "slot": "infotainment", "match": "^infodivertissement$" },
    { "slot": "controls", "match": "^commandes$" },

    { "slot": "dashboard", "match": "^planche de bord$" },
    { "slot": "driver", "match": "^poste de conduite$" },
    { "slot": "seats_row1", "match": "^rang 1$", "explode": { "lift": 0.9 } },
    { "slot": "seats_row2", "match": "^rang 2$", "explode": { "lift": 0.9 } },
    { "slot": "trim", "match": "^garnissage$" },
    { "slot": "boot", "match": "^coffre$" },
    { "slot": "hvac", "match": "^climatisation( et chauffage)?$" }
  ],
  "systemZones": [
    { "match": "caisse|structure", "at": [0.2, 1.0, 0] },
    { "match": "carrosserie|ouvrant|aerodynamique", "at": [0.2, 1.35, 0] },
    { "match": "motopropulseur|moteur|traction", "at": [-1.5, 1.05, 0] },
    { "match": "liaison au sol|chassis", "at": [0, 0.3, 0] },
    { "match": "electri", "at": [-1.1, 1.3, 0] },
    { "match": "habitacle|interieur", "at": [0.5, 1.0, 0] }
  ],
  "defaultZone": [0, 2.3, 0]
}
